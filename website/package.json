{
  "private": true,
  "name": "dumi-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yujiaao/c-tools.git",
    "branch": "main",
    "platform": "github"
  },
  "scripts": {
    "sync-versions": "node scripts/sync-versions.mjs",
    "sync-versions:check": "node scripts/sync-versions.mjs --check",
    "restore-version-placeholders": "node scripts/restore-version-placeholders.mjs",
    "prestart": "npm run sync-versions",
    "prebuild": "npm run sync-versions",
    "postbuild": "npm run restore-version-placeholders",
    "start": "dumi dev",
    "build": "dumi build",
    "translateAll": "node translateAll.js",
    "translate": "node translateFile.js",
    "prettier": "prettier --write \"**/*.{js,jsx,tsx,ts,less,md,json}\"",
    "deploy": "gh-pages -d dist"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "dumi": "^1.1.49",
    "dumi-theme-default": "~1.0.0",
    "gh-pages": "^3.1.0",
    "lint-staged": "^10.0.7",
    "prettier": "^1.19.1",
    "yorkie": "^2.0.0"
  },
  "dependencies": {
    "fs": "^0.0.1-security",
    "node-fetch": "^2.6.1",
    "path": "^0.12.7",
    "pnpm": "^7.14.2",
    "prism-react-renderer": "^1.2.0",
    "slash": "^3.0.0",
    "sleep": "^6.3.0"
  }
}
