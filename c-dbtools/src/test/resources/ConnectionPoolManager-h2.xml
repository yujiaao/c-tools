<?xml version="1.0" standalone="yes"?>
  <poolResources>
  <MonitorInterval>60</MonitorInterval>

  <!-- 内存 H2（INIT 加载 h2test.sql），CI / 无 MySQL 时使用 -->
   <Alias
  	name="test1"
  	driver="org.h2.Driver"
  	url="jdbc:h2:mem:cm_test;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE;INIT=RUNSCRIPT FROM 'classpath:h2test.sql'"
  	username="sa"
  	password="sa"
  	maxConn="6"
  	idleTimeout="200"
  	checkoutTimeout="500"
  	maxCheckout="50"
  />

  </poolResources>
