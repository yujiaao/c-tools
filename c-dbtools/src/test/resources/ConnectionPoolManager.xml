<?xml version="1.0" standalone="yes"?>
  <poolResources>
  <MonitorInterval>60</MonitorInterval>
  <!-- 默认与 ConnectionPoolManager-h2.xml 相同，供未跑过 Maven probe 的 IDE 直接跑测试。
       执行 mvn test-compile / test 时由 ConnectionPoolConfigProbe 按探测结果覆盖本文件到 target。 -->
   <Alias
  	name="test1"
  	driver="org.h2.Driver"
  	url="jdbc:h2:mem:cm_test;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE;INIT=RUNSCRIPT FROM 'classpath:h2test.sql'"
  	username="sa"
  	password="sa"
  	maxConn="6"
  	idleTimeout="200"
  	checkoutTimeout="500"
  	maxCheckout="50"
  />

  </poolResources>
